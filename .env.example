# Copy to .env or .env.local and fill in your local values.
# Existing shell exports and MCP client env blocks override this file.

RUNPOD_API_KEY=
RUNPOD_ANALYSIS_ENDPOINT_ID=
RUNPOD_WORKER_IMAGE=
# Optional comma-separated endpoint GPU priority list.
# RUNPOD_ENDPOINT_GPU_TYPES=NVIDIA H100 80GB HBM3,NVIDIA A100 80GB PCIe,NVIDIA GeForce RTX 4090

# Preferred remote staging path: upload source-safe copies into a RunPod network
# volume, then let the Serverless worker read them from /runpod-volume.
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_NETWORK_VOLUME_DATACENTER_ID=US-NC-1
RUNPOD_NETWORK_VOLUME_ENDPOINT_URL=https://s3api-us-nc-1.runpod.io
RUNPOD_VOLUME_REMOTE_PREFIX=resolve-mcp-staging
RUNPOD_VOLUME_MOUNT_PATH=/runpod-volume

# RunPod S3-compatible API credentials for the network volume.
# These are separate from RUNPOD_API_KEY.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or use these aliases instead:
# RUNPOD_S3_ACCESS_KEY_ID=
# RUNPOD_S3_SECRET_ACCESS_KEY=

# Map local media paths to URLs the RunPod worker can read.
# This is only needed when not using RUNPOD_NETWORK_VOLUME_ID.
# Example:
# RUNPOD_MEDIA_LOCAL_PREFIX=/Volumes/YourMedia
# RUNPOD_MEDIA_URL_PREFIX=https://your-staged-media.example.com
RUNPOD_MEDIA_LOCAL_PREFIX=
RUNPOD_MEDIA_URL_PREFIX=

# Default staging retention policy for uploaded media copies. This value is
# carried in RunPod job input; actual deletion is handled by the staging backend
# lifecycle policy or cleanup script.
RUNPOD_STAGING_RETENTION_DAYS=14
